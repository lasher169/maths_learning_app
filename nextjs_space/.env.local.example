# ================================
# MathMentor - Environment Variables
# ================================
# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# === Supabase Database ===
# Get these from your Supabase project: Settings > Database > Connection string
# Use the "Transaction" connection string (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use the "Session" connection string (port 5432) for DIRECT_URL
# This is used by Prisma for migrations/schema push
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# === Authentication ===
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"

# Set this to your app URL (for local Raspberry Pi deployment)
NEXTAUTH_URL="http://localhost:3000"

# === LLM API (OpenAI-compatible) ===
# Single endpoint used for both question generation and answer evaluation.
# Defaults below target a local MLX server (https://github.com/ml-explore/mlx-examples).
# Point this at any OpenAI-compatible server/provider.
# No "model" field is sent — the server uses its loaded default model.
LLM_API_URL="http://localhost:8080/v1/chat/completions"
LLM_API_KEY="your-api-key"
